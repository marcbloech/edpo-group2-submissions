# Default: local (self-managed) mode. Switch to Camunda Cloud with:
#   docker compose --env-file .env.cloud up --build -d
CAMUNDA_CLIENT_MODE=selfManaged

# Market Scanner — MOCKED needs no key. For live data set MARKET_MODE=REAL
# and supply your own Finnhub key (https://finnhub.io).
FINNHUB_API_KEY=<your-finnhub-api-key>
MARKET_MODE=MOCKED
