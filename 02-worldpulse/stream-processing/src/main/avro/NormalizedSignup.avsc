{
  "type": "record",
  "name": "NormalizedSignup",
  "namespace": "ch.unisg.worldpulse.streams.avro",
  "fields": [
    {"name": "userId", "type": "string"},
    {"name": "name", "type": "string"},
    {"name": "email", "type": "string"},
    {"name": "tier", "type": {"type": "enum", "name": "Tier", "symbols": ["FREE", "BASIC", "PREMIUM", "ENTERPRISE"]}},
    {"name": "eventType", "type": "string"},
    {"name": "timestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
