{
  "type": "record",
  "name": "UserActivity",
  "namespace": "ch.unisg.worldpulse.streams.avro",
  "fields": [
    {"name": "userId", "type": "string"},
    {"name": "name", "type": "string"},
    {"name": "email", "type": "string"},
    {"name": "currentTier", "type": "string"},
    {"name": "eventCount", "type": "long"},
    {"name": "lastEventType", "type": "string"},
    {"name": "lastEventTimestamp", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
