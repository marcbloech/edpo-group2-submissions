# ─── Camunda 8 Cloud (SaaS) mode ───
# Copy this file to .env and fill in your credentials.
# Get these from Camunda Console → API → Create new client.
#
# When .env is absent, all services default to selfManaged mode
# and connect to the local Zeebe container in docker-compose.

CAMUNDA_CLIENT_MODE=saas
CAMUNDA_CLUSTER_ID=<your-cluster-id>
CAMUNDA_CLUSTER_REGION=<your-region>
CAMUNDA_CLIENT_ID=<your-client-id>
CAMUNDA_CLIENT_SECRET=<your-client-secret>
CAMUNDA_OAUTH_URL=https://login.cloud.camunda.io/oauth/token
CAMUNDA_CLOUD_BASE_URL=zeebe.camunda.io
ZEEBE_GRPC_ADDRESS=https://<your-cluster-id>.<your-region>.zeebe.camunda.io

# ─── Market Scanner (optional — live financial data) ───
# MOCKED (default) needs no key. For live data set MARKET_MODE=REAL and supply
# your own Finnhub key (https://finnhub.io).
FINNHUB_API_KEY=<your-finnhub-api-key>
MARKET_MODE=MOCKED

# ─── Slack connector (optional — Camunda BPMN Slack task) ───
# Only needed if you wire the Slack connector into the process model.
SLACK_OAUTH_TOKEN=<your-slack-bot-token>
SLACK_CHANNEL=<your-slack-channel-id>
